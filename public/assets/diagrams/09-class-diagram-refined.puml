  +read_at : datetime
}

class FaqCategory {
  +id : bigint
  +name : string
  +slug : string
  +sort_order : int
}

class Faq {
  +id : bigint
  +faq_category_id : bigint
  +question : string
  +answer : text
  +sort_order : int
