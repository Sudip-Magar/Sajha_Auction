@startuml
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName Arial

title Sajha Auction - Refined Class Diagram (domain, services, notifications)

class User <<Authenticatable, Notifiable>> {
  +id : bigint
  +google_id : string
  +name : string
  +email : string
  +username : string
  +phone : string
  +date_of_birth_en : date
  +daate_of_birth_np : string
  +gender : string
  +bio : text
  +avatar : string
  -password : string <<hashed>>
  +is_verified : bool
  +is_seller : bool
  +seller_application_pending : bool
  +is_auction_allowed : bool
  +status : string
  --
  +isActiveStatus() : bool
  +scopeActive(query) : Builder
}

class Admin <<Authenticatable, Notifiable>> {
  +id : bigint
  +name : string
  +email : string
  +phone : string
  +role : string
  +position : string
  +date_of_joining : string
  +gender : string
  -password : string <<hashed>>
  +avatar : string
  +address : string
  +status : string
  --
  +receivesBroadcastNotificationsOn() : string
}

class DocumentImage {
  +id : bigint
  +user_id : bigint
  +type : DocumentImageType
  +image : string
  +is_approved : bool
  +is_rejected : bool
}

class Category {
  +id : bigint
  +name : string
  +slug : string
  +description : text
  +image : string
  +icon : string
  +color : string
  +status : string
  +sort_order : int
  --
  +children() : HasMany
}

class SubCategory {
  +id : bigint
  +category_id : bigint
  +name : string
  +slug : string
  +description : text
  +image : string
  +icon : string
  +color : string
  +status : string
  +sort_order : int
}

class Product {
  +id : bigint
  +sku : string
  +seller_id : bigint
  +sub_category_id : bigint
  +name : string
  +slug : string
  +description : text
  +specifications : text
  +condition : string
  +usage_duration : string
  +purchase_date : date
  +quantity : string
  +retail_price : decimal(15,2)
  +sale_price : decimal(15,2)
  +negotiable : ProductNegotiability
  +listing_type : ProductSaleType
