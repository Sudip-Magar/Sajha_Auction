' ownership and catalogue
sub --> cat : category_id
camera --> sub : sub_category_id
camera --> seller : seller_id
doc --> seller : user_id
img --> camera : product_id
tl --> camera : product_id
tl --> bidder1 : actor_id

' auction
auction --> camera : product_id
rules --> auction : auction_id
bid1 --> auction : auction_id
bid2 --> auction : auction_id
bid3 --> auction : auction_id
bid4 --> auction : auction_id
bid1 --> bidder2 : bidder_id
bid2 --> bidder1 : bidder_id
bid3 --> bidder2 : bidder_id
bid4 --> bidder1 : bidder_id
auction --> bidder1 : winner_id

' settlement
order --> auction : auction_id
order --> bidder1 : buyer_id
order --> seller : seller_id
item --> order : order_id
item --> camera : product_id
alert --> seller : notifiable_id

admin1 ..> camera : approved via Product::approveListing()

